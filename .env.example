# Скопируйте в .env и отредактируйте. НЕ храните .env в системе контроля версий!
# Генерация ключа: openssl rand -hex 32
SECRET_KEY=change-me

# Путь к файлу базы данных
DB_PATH=/opt/vyruchka/data/vyruchka.db

# Secure cookie: только true, если сайт доступен по HTTPS
COOKIE_SECURE=false

# Первичный администратор (создаётся: venv/bin/python -m app.create_admin)
ADMIN_USERNAME=admin
# Если пусто — пароль будет сгенерирован и выведен в консоль
ADMIN_PASSWORD=

# Включить Swagger /docs в проде
ENABLE_DOCS=false