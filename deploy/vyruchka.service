[Unit]
Description=Vyruchka v2 — FastAPI (учёт выручки водителей)
After=network.target

[Service]
Type=simple
User=vyruchka
Group=vyruchka
WorkingDirectory=/opt/vyruchka
EnvironmentFile=/opt/vyruchka/.env
ExecStart=/opt/vyruchka/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

# Безопасность
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWriteDirectories=/opt/vyruchka/data

[Install]
WantedBy=multi-user.target